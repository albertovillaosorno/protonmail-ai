# Rust backup files. A root `target/` is intentionally not ignored: Jig rejects
# it because Cargo output belongs under `.cache/cargo-target`.
**/*.rs.bk

# Local reference corpus: useful for research, never published wholesale.
/reference/

# Credentials and local state
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
/config/local.*
/state/

# Jig and local tooling state
/.cache/
/.dependencies/
/.temp/
/.jig/graph/jig.db
/.jig/graph/jig.db-*

# Editors and operating systems
.DS_Store
.idea/
.vscode/
*.swp
*~
